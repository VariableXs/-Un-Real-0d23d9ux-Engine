# ── 测试产物与归档区（可重建，不入库）────────────────────────────
# _attic = 测试软件/测试截图归档区（126 个文件 43MB：探测脚本、对比截图、
# 损坏备份）。保留在本地磁盘，不进版本库。
VarixTaskOps/VTaskBoard/_attic/
VarixTaskOps/VTaskBoard/_tex/
VarixTaskOps/VTaskBoard/_wehd/
VarixTaskOps/VTaskBoard/_probe*.py
VarixTaskOps/VTaskBoard/_probe*.js
VarixTaskOps/VTaskBoard/_cmp_*
VarixTaskOps/VTaskBoard/_shot_*
VarixTaskOps/VTaskBoard/_lv_*
VarixTaskOps/VTaskBoard/_va_*
VarixTaskOps/VTaskBoard/_srv_ready

# ── 构建产物 ──────────────────────────────────────────────────────
VarixTaskOps/VTaskBoard/build/
VarixTaskOps/VTaskBoard/dist/
VarixTaskOps/VTaskBoard/*.spec
__pycache__/
*.pyc

# ── 壁纸 4K 母版缓存（可再生，体积巨大，禁止入库）──────────────────
# _m4k 580MB + _wetexture 167MB + _exehome 718MB。
# 全部是 Real-ESRGAN 超分与 NVENC 重编码的**产物**，删掉会自动重算。
VarixTaskOps/VTaskBoard/_m4k/
VarixTaskOps/VTaskBoard/_wetexture/
VarixTaskOps/VTaskBoard/_exehome/
# 母版原子写中途产物（进程被杀会残留 .part）
*.part
# Real-ESRGAN 引擎与模型（51MB，外部依赖，可由脚本重建）
VarixTaskOps/VTaskBoard/_sr/
# ffmpeg 二进制（15MB，由 VTaskBoard.spec 收集进包）
VarixTaskOps/VTaskBoard/ffmpeg/
# exe 本体由 PyInstaller 从 spec 构建
*.exe

# ── 运行时临时文件 ────────────────────────────────────────────────
*.lock
chromiumerrorsentinel.lock
Typora_Hook_Log.txt

# ── 大体积本地数据 ────────────────────────────────────────────────
# taskboard.md 35MB 为本地任务台账，随用随改，不适合入库。
VarixTaskOps/VTaskBoard/taskboard.md

# ── 用户本地壁纸与素材 ────────────────────────────────────────────
# 壁纸/贴图/素材为用户本地资产（含 WE 创意工坊派生图），不入库。
VarixTaskOps/VTaskBoard/wallpapers/
VarixTaskOps/VTaskBoard/assets/
VarixTaskOps/VTaskBoard/*.png
VarixTaskOps/VTaskBoard/*.jpg
VarixTaskOps/VTaskBoard/*.ico
VarixTaskOps/VTaskBoard/*.txt