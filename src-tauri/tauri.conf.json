{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Variable",
  "version": "1.0.0",
  "identifier": "com.variable.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "desktop",
        "title": "Variable — Private Desktop Environment",
        "url": "desktop.html",
        "fullscreen": true,
        "transparent": false,
        "alwaysOnTop": true,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
