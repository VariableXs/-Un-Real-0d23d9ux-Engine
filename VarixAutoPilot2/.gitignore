# 构建产物（target/ 几十MB）
src-tauri/target/
# Tauri 自动生成的 schema（每次 build 都会重写）
src-tauri/gen/

# 搬上来的可执行文件本体 —— 3.85MB 二进制不入库。
# 理由：每次构建都会变，提交它只会给每次 clone 多 3.85MB 死重量。
# 需要时按 README「重新构建」一节自己 build。
VarixAutoPilot.exe

# 运行期产物
shots/
tools/probe*.mjs
tools/shoot.mjs
tools/probe*.py

#★ 例外：open_port.py 是功能代码，不是测试脚本 ★
# 仓库根 .gitignore 第 94 行有 `tools/`，会把整个 tools 目录忽略掉。
# 但 `open_port.py` 是**交付的一部分**——用户靠它一键开端口，
# 属于源码保护红线里说的"源码只增不减"，绝不能丢。
# gitignore 里 `!` 不能复活被上级目录规则忽略的路径，
# 所以在**根 .gitignore** 侧加例外（见根仓库 .gitignore 的 tools/ 段）。
# 这里只做本目录的兜底，真正生效的是根目录那条。
!tools/open_port.py
src-tauri/examples/live_check.rs
src-tauri/examples/live_who.rs
