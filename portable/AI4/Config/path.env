# Variable OS 配置随盘走 - Data\Env\path.env
# Core 启动时读取并 SetEnvironmentVariable; ${DATA_ROOT} 会被 Config-Runtime.ps1
# 展开为 "<DataDrive>\Data" (换宿主盘符只改 -DataDrive, 路径随盘走不写死)。

# 工具/运行时(绿色便携)
PATH_DATA_TOOLS=${DATA_ROOT}\Tools
PATH_DATA_RUNTIMES=${DATA_ROOT}\Runtimes

# 插件根目录
VARIABLE_PLUGIN_ROOT=${DATA_ROOT}\Plugins

# MSIX App Attach 目录
VARIABLE_MSIX_DIR=${DATA_ROOT}\MSIX
VARIABLE_MSIX_MOUNT=${DATA_ROOT}\MSIX\Mount

# 云同步目标, 留空不启用
VARIABLE_CLOUD_REMOTE=remote:VariableBackup

# 交换/受控通道
VARIABLE_EXCHANGE=${DATA_ROOT}\Exchange
VARIABLE_SYNC_INTERVAL_MIN=30
VARIABLE_SYNC_DELAY_SEC=10
