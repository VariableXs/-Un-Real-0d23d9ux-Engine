# Variable OS 配置随盘走 - Data\Env\path.env
# Core 启动时读取并 SetEnvironmentVariable; 支持相对路径(相对 DataRoot)。

# 工具/运行时(绿色便携)
PATH_DATA_TOOLS=D:\Data\Tools
PATH_DATA_RUNTIMES=D:\Data\Runtimes

# 插件根目录
VARIABLE_PLUGIN_ROOT=D:\Data\Plugins

# MSIX App Attach 目录
VARIABLE_MSIX_DIR=D:\Data\MSIX
VARIABLE_MSIX_MOUNT=D:\Data\MSIX\Mount

# 云同步目标, 留空不启用
VARIABLE_CLOUD_REMOTE=remote:VariableBackup

# 交换/受控通道
VARIABLE_EXCHANGE=D:\Data\Exchange
VARIABLE_SYNC_INTERVAL_MIN=30
VARIABLE_SYNC_DELAY_SEC=10
